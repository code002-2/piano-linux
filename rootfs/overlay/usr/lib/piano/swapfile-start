#!/bin/sh
# swapfile-start: a 16 GB swap file on userdata (piano-swapfile service),
# used only once the zram swap (priority 100) is full.
#
# Created on first use, after local-fs.target: the root filesystem has grown
# to the whole partition by then.  /etc/piano/swap.conf may set SIZE (for
# fallocate; delete the file to resize) or SIZE=0 to turn it off.
set -eu

SWAPFILE=/swapfile
SIZE=16G
PRIORITY=10
# shellcheck source=/dev/null
[ ! -r /etc/piano/swap.conf ] || . /etc/piano/swap.conf

[ "$SIZE" != 0 ] || exit 0
if [ ! -f "$SWAPFILE" ]; then
    rm -f "$SWAPFILE.new"
    # Swap on ext4 needs fully allocated blocks: fallocate, not a sparse file.
    fallocate -l "$SIZE" "$SWAPFILE.new"
    chmod 600 "$SWAPFILE.new"
    mkswap -q "$SWAPFILE.new"
    mv "$SWAPFILE.new" "$SWAPFILE"
fi
swapon --show=NAME --noheadings | grep -qx "$SWAPFILE" ||
    swapon -p "$PRIORITY" "$SWAPFILE"
