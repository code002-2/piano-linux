						touchpad,edge-area-bottom-max = <0x857>;
						touchpad,shield-frame-count-limit = <0x8c>;
						touchpad,one-swipe-dis-limit = <0x9c40>;
						touchpad,two-swipe-dis-limit = <0x9c4>;
						touchpad,two-pinch-dis-limit = <0x9c4>;
						touchpad,three-swipe-dis-limit = <0x2710>;
						touchpad,two-fingers-gesture-dis = <0xe1f04>;
					};

					pid_1294 {
						compatible = "nanosic-pid-1294";
						touchpad,edge-area-left-min = <0x00>;
						touchpad,edge-area-left-max = <0x140>;
						touchpad,edge-area-right-min = <0xb3f>;
						touchpad,edge-area-right-max = <0xc7f>;
						touchpad,edge-area-top-min = <0x00>;
						touchpad,edge-area-top-max = <0xd5>;
						touchpad,edge-area-bottom-min = <0x782>;
						touchpad,edge-area-bottom-max = <0x857>;
						touchpad,shield-frame-count-limit = <0x8c>;
						touchpad,one-swipe-dis-limit = <0x9c40>;
						touchpad,two-swipe-dis-limit = <0x9c4>;
