	fragment@56 {
		target = <&soc>;

		__overlay__ {

			qcom,smp2p-adsp {

				hall_smp2p_in_lid: qcom,hall-in-lid {
					qcom,entry-name = "mi_hall_lid";
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x53>;
				};

				hall_smp2p_in_table: qcom,hall-in-table {
					qcom,entry-name = "mi_hall_table";
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x54>;
				};
			};

			xiaomi_hall {
				compatible = "xiaomi-hall";
				status = "ok";

				lid_hall {
					label = "lid_hall";
					gpios = <&tlmm>, <0x50 0x01>;
					linux,input-type = <0x05>;
					linux,code = <0x00>;
					interrupts-extended = <&hall_smp2p_in_lid>, <0x00 0x00>, <&hall_smp2p_in_lid>, <0x01 0x00>;
					interrupt-names = "open_irq", "close_irq";
				};

				table_hall {
					label = "table_hall";
					gpios = <&tlmm>, <0x0b 0x01>;
					linux,input-type = <0x05>;
					linux,code = <0x01>;
					interrupts-extended = <&hall_smp2p_in_table>, <0x00 0x00>, <&hall_smp2p_in_table>, <0x01 0x00>;
					interrupt-names = "open_irq", "close_irq";
				};
			};

			xiaomi_wifi_gpio {
				compatible = "xiaomi,xiaomi-wifi";
				gpio = <&tlmm>, <0x4f 0x00>;
				debounce-time = <0x1e>;
				pinctrl-names = "default";
				pinctrl-0 = <&wifi_ctrl_irq>;
				status = "ok";
			};

			touch_avdd_vreg: touch_avdd_vreg {
				compatible = "regulator-fixed";
				regulator-name = "touch_avdd_vreg";
				enable-active-high;
				gpio = <&tlmm>, <0x72 0x00>;
				phandle = <0x102>;
			};

			xiaomi_fingerprint {
				compatible = "xiaomi,xiaomi-fp";
				xiaomi,gpio_irq = <&tlmm>, <0x55 0x00>;
				xiaomi,vendor_names = "p81_n1_142";
				fp_3v3_vreg-supply = <&L9B>;
				netlink-event = <0x19>;
				pinctrl-names = "reset_high", "reset_low", "irq_default";
				pinctrl-0 = <&fingerprint_reset_high>;
				pinctrl-1 = <&fingerprint_reset_low>;
				pinctrl-2 = <&fingerprint_irq_default>;
				status = "ok";
			};
		};
	};

	fragment@57 {
		target = <&qseecom_mem>;

		__overlay__ {
			size = <0x00 0x4000000>;
		};
	};

	fragment@58 {
		target = <&qseecom_ta_mem>;

		__overlay__ {
			size = <0x00 0x3800000>;
		};
	};

	fragment@59 {
		target = <&reserved_memory>;

		__overlay__ {

			oem_vm_mem: oem_vm_region@f8800000 {
				reg = <0x00 0xf8800000 0x00 0x3800000>;
				phandle = <0x5c>;
			};

			oem_vm_shm: shm@fc000000 {
				no-map;
				reg = <0x00 0xfc000000 0x00 0x400000>;
				gunyah-label = <0x03>;
				phandle = <0x5d>;
			};

			q6_adsp_dtb_mem: q6_adsp_dtb_region@9ed80000 {
				no-map;
				reg = <0x00 0x9ed80000 0x00 0x80000>;
				phandle = <0x5b>;
			};

			adspslpi_mem: adspslpi_region@9ee00000 {
				no-map;
				reg = <0x00 0xb8200000 0x00 0x5780000>;
				phandle = <0x5a>;
			};
		};
	};

	fragment@60 {
		target = <&soc>;

		__overlay__ {

			adsp_sleepmon: adsp-sleepmon {
				qcom,rproc-handle = <&adsp_pas>;
				phandle = <0x103>;
			};

			adsp_loader: qcom,msm-adsp-loader {
				status = "ok";
				qcom,rproc-handle = <&adsp_pas>;
				phandle = <0x104>;
			};

			adsp_notify: qcom,msm-adsp-notify {
				qcom,rproc-handle = <&adsp_pas>;
				phandle = <0x105>;
			};

			adsp_pas: remoteproc-adsp@03000000 {
				memory-region = <&adspslpi_mem>, <&q6_adsp_dtb_mem>;
				phandle = <0x59>;
			};

			gh-secure-vm-loader@1 {
				memory-region = <&oem_vm_mem>, <&vm_comm_mem>;
			};

			mitee: mitee {
				compatible = "xiaomi,mitee";
				binding-core = <0x04 0x05 0x06>;
				tui-supported;
				phandle = <0x106>;
			};

			mitee-oemvm {
				compatible = "xiaomi,mitee-hlos-ipc";
				xiaomi,master;
				gunyah-shm-label = <0x03>;
				peer-name = <0x04>;
				shared-buffer = <&oem_vm_shm>;
			};
		};
	};

	fragment@61 {
		target = <&L9B>;

		__overlay__ {
			regulator-min-microvolt = <0x325aa0>;
			regulator-max-microvolt = <0x325aa0>;
			qcom,init-voltage = <0x325aa0>;
		};
	};

	fragment@62 {
		target = <&L12B>;

		__overlay__ {
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			qcom,init-voltage = <0x1b7740>;
		};
	};

	fragment@63 {
		target = <&tlmm>;

		__overlay__ {

			fingerprint_reset_high: fingerprint_reset_high {
				phandle = <0x56>;

				mux {
					pins = "gpio73";
					function = "gpio";
				};

				config {
					pins = "gpio73";
					drive-strength = <0x02>;
					bias-disable;
					output-high;
				};
			};

			fingerprint_reset_low: fingerprint_reset_low {
				phandle = <0x57>;

				mux {
					pins = "gpio73";
					function = "gpio";
				};

				config {
					pins = "gpio73";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};

			fingerprint_irq_default: fingerprint_irq_default {
				phandle = <0x58>;

				mux {
					pins = "gpio85";
					function = "gpio";
				};

				config {
					pins = "gpio85";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};
		};
	};

	fragment@64 {
		target = <&thermal_zones>;

