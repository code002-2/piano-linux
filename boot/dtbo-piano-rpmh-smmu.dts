	fragment@66 {
		target = <&qupv3_se10_i2c>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0x61a80>;

			ntag@57 {
				compatible = "fm,fm19511";
				reg = <0x57>;
				qcom,ntag-irq = <&tlmm>, <0xd1 0x00>;
				interrupt-parent = <&tlmm>;
				interrupts = <0xd1 0x00>;
				interrupt-names = "ntag_irq";
				pinctrl-names = "default", "suspend";
				pinctrl-0 = <&ntag_int_default>;
				pinctrl-1 = <&ntag_int_suspend>;
			};
		};
	};

	fragment@67 {
		target = <&usb0>;

		__overlay__ {
			qcom,wcd_usbss = <&wcd_usbss>;
			wcd_equ = <0xb0>;
			wcd_equ_host = <0xb0>;
		};
	};

	fragment@68 {
		target = <&dwc3_0>;

		__overlay__ {
			usb-phy = <&eusb2_phy0>, <&usb_qmp_dp_phy>;
			maximum-speed = "super-speed";
		};
	};

	fragment@69 {
		target = <&usb_qmp_dp_phy>;

		__overlay__ {
			usb3,eyegram-tuning;
			qcom,usb3-phy-eye-seq = <0x1f38 0x1f 0x1f6c 0x19>;
			qcom,host-usb3-phy-eye-seq = <0x1f38 0x1f 0x1f6c 0x19>;
		};
	};

	fragment@70 {
		target = <&soc>;

		__overlay__ {

			xiaomi_mi_trace {
				compatible = "xiaomi,mi_trace";
				mt-size = <0x100000>;
			};
		};
	};

	fragment@71 {
		target = <&tlmm>;

		__overlay__ {

			nanosic_keyboard_mcu {

				xiaomi_keyboard_sleep_default: xiaomi_keyboard_sleep_default {
					phandle = <0x63>;

					mux {
						pins = "gpio3";
						function = "gpio";
					};

					config {
						pins = "gpio3";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				xiaomi_keyboard_default: xiaomi_keyboard_default {
					phandle = <0x64>;

					mux {
						pins = "gpio188", "gpio95";
						function = "gpio";
					};

					config {
						pins = "gpio188", "gpio95";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};

			mi_qupv3_se6_i2c_pins: mi_qupv3_se6_i2c_pins {
				phandle = <0x107>;

				mi_qupv3_se6_i2c_sda_active: mi_qupv3_se6_i2c_sda_active {
					phandle = <0x60>;

					mux {
						pins = "gpio56";
						function = "qup1_se6_l0";
					};

					config {
						pins = "gpio56";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				mi_qupv3_se6_i2c_scl_active: mi_qupv3_se6_i2c_scl_active {
					phandle = <0x61>;

					mux {
						pins = "gpio57";
						function = "qup1_se6_l1";
					};

					config {
						pins = "gpio57";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				mi_qupv3_se6_i2c_sleep: mi_qupv3_se6_i2c_sleep {
					phandle = <0x62>;

					mux {
						pins = "gpio56", "gpio57";
						function = "gpio";
					};

					config {
						pins = "gpio56", "gpio57";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
		};
	};

	fragment@72 {
		target = <&qupv3_se6_i2c>;

		__overlay__ {
			status = "ok";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&mi_qupv3_se6_i2c_sda_active>, <&mi_qupv3_se6_i2c_scl_active>;
			pinctrl-1 = <&mi_qupv3_se6_i2c_sleep>;
			qcom,clk-freq-out = <0xf4240>;

			nanosic@4c {
				compatible = "nanosic,803";
				reg = <0x4c>;
				pinctrl-names = "default";
				pinctrl-0 = <&xiaomi_keyboard_sleep_default>, <&xiaomi_keyboard_default>;
				irq_pin = <&tlmm>, <0x61 0x2001>;
				reset_pin = <&tlmm>, <0xbc 0x00>;
				status_pin = <&tlmm>, <0x5f 0x00>;
				sleep_pin = <&tlmm>, <0x03 0x00>;
				nanosic,vdd-name = "vdd";
				vdd-supply = <&L14B>;
				nanosic,dvdd-name = "dvdd";
				dvdd-supply = <&L11B>;

				touchpad-configs {

					pid_1260 {
