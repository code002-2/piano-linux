	fragment@53 {
		target = <&tlmm>;

		__overlay__ {

			mi_ts_spi_clk_suspend: mi_ts_spi_clk_suspend {
				phandle = <0x50>;

				mux {
					pins = "gpio42";
					function = "gpio";
				};

				config {
					pins = "gpio42";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};

			mi_ts_spi_mosi_suspend: mi_ts_spi_mosi_suspend {
				phandle = <0x4e>;

				mux {
					pins = "gpio41";
					function = "gpio";
				};

				config {
					pins = "gpio41";
					drive-strength = <0x02>;
					output-low;
					bias-disable;
				};
			};

			mi_ts_spi_miso_suspend: mi_ts_spi_miso_suspend {
				phandle = <0x4f>;

				mux {
					pins = "gpio40";
					function = "gpio";
				};

				config {
					pins = "gpio40";
					drive-strength = <0x02>;
					output-low;
					bias-disable;
				};
			};

			mi_ts_spi_cs_active: mi_ts_spi_cs_active {
				phandle = <0x51>;

				mux {
					pins = "gpio43";
					function = "qup1_se2_l3";
				};

				config {
					pins = "gpio43";
					drive-strength = <0x06>;
					bias-disable;
				};
			};

			mi_ts_spi_cs_suspend: mi_ts_spi_cs_suspend {
				phandle = <0x52>;

				mux {
					pins = "gpio43";
					function = "gpio";
				};

				config {
					pins = "gpio43";
					drive-strength = <0x06>;
					bias-pull-down;
					output-low;
				};
			};
		};
	};

