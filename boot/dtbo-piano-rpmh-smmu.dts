						touchpad,two-swipe-dis-limit = <0x9c4>;
						touchpad,two-pinch-dis-limit = <0x9c4>;
						touchpad,three-swipe-dis-limit = <0x2710>;
						touchpad,two-fingers-gesture-dis = <0xe1f04>;
