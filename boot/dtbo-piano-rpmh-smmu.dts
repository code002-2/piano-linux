				pinctrl-0 = <&cam_sensor_wide_mclk1_active>, <&cam_sensor_wide_active_rst1>;
				pinctrl-names = "cam_default", "cam_suspend";
				gpio-no-mux = <0x00>;
				rgltr-load-current = <0x27100 0xc350 0xb71b0 0x00 0xf4240>;
				rgltr-max-voltage = <0x2ab980 0x1b7740 0x10c8e0 0x00 0x3c6cc0>;
				rgltr-min-voltage = <0x2ab980 0x1b7740 0x10c8e0 0x00 0x2de600>;
