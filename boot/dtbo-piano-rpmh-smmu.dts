			led_flash_rear_wide: qcom,camera-flash0 {
				phandle = <0x127>;
				status = "ok";
				switch-source = <&pm8550_switch2>;
				torch-source = <&pm8550_torch0>, <&pm8550_torch1>;
				flash-source = <&pm8550_flash0>, <&pm8550_flash1>;
				compatible = "qcom,camera-flash";
				cell-index = <0x00>;
			};

			camera_wide_avdd_ldo: gpio-regulator@0 {
				phandle = <0x120>;
				pinctrl-0 = <&cam_sensor_wide_active_avdd>, <&cam_sensor_wide_suspend_avdd>;
				pinctrl-names = "wide_avdd_active", "wide_avdd_suspend";
				gpio = <&tlmm>, <0xaf 0x00>;
				enable-active-high;
				regulator-enable-ramp-delay = <0x64>;
				regulator-max-microvolt = <0x2ab980>;
				regulator-min-microvolt = <0x2ab980>;
				regulator-name = "camera_wide_avdd_ldo";
				reg = <0x00 0x00>;
				compatible = "regulator-fixed";
			};

			camera_front_avdd_ldo: gpio-regulator@1 {
				phandle = <0x12c>;
				pinctrl-0 = <&cam_sensor_front_active_avdd>, <&cam_sensor_front_suspend_avdd>;
				pinctrl-names = "front_avdd_active", "front_avdd_suspend";
				gpio = <&tlmm>, <0xb0 0x00>;
				enable-active-high;
				regulator-enable-ramp-delay = <0x64>;
				regulator-max-microvolt = <0x2ab980>;
				regulator-min-microvolt = <0x2ab980>;
				regulator-name = "camera_front_avdd_ldo";
				reg = <0x01 0x00>;
				compatible = "regulator-fixed";
			};
		};
	};

