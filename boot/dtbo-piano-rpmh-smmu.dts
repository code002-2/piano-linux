					config {
						bias-pull-up;
						output-high;
						drive-strength = <0x10>;
						pins = "gpio16";
					};
				};

				cnss_wlan_en_sleep: cnss_wlan_en_sleep {
					phandle = <0x109>;

					mux {
						function = "gpio";
						pins = "gpio16";
					};

