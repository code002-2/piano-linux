					config {
						qcom,remote;
						drive-strength = <0x04>;
						pins = "gpio4", "gpio5";
					};
				};
			};

			cam_sensor_front_mclk4_active: cam_sensor_front_mclk4_active {
				phandle = <0x12d>;

				mux {
					function = "cam_asc_mclk4";
					pins = "gpio93";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio93";
