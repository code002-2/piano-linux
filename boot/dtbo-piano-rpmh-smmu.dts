					#interrupt-cells = <0x02>;
					phandle = <0xb5>;

					quiet_therm {

						quiet_therm_default: quiet_therm_default {
							pins = "gpio6";
							bias-high-impedance;
							phandle = <0x20>;
						};
					};

					charger1_therm {

						charger1_therm_default: charger1_therm_default {
							pins = "gpio12";
							bias-high-impedance;
							phandle = <0x21>;
						};
					};
				};

				pmih010x_eusb2_repeater: eusb2-repeater@fd00 {
					compatible = "qcom,pmic-eusb2-repeater";
					reg = <0xfd00>;
					vdd18-supply = <&pm_humu_l15>;
					vdd3-supply = <&pm_humu_l5>;
					qcom,param-override-seq = <0x00 0x50 0x0e 0x51 0x01 0x52 0x07 0x53 0x03 0x54 0x03 0x55 0x00 0x56 0x06 0x57 0x02 0x58 0x03 0x59 0x01 0x5a 0x02 0x5b>;
					qcom,host-param-override-seq = <0x00 0x50 0x0f 0x51 0x02 0x52 0x07 0x53 0x01 0x54 0x03 0x55 0x03 0x56 0x05 0x57 0x02 0x58 0x03 0x59 0x01 0x5a 0x02 0x5b>;
					phandle = <0x3d>;
				};

				pmih010x_haptics: qcom,hv-haptics@f000 {
					qcom,lra-f0-cal-count = <0x23a>;
					qcom,lra-f0-default = <0x84>;
					qcom,lra-f0-max = <0x8c>;
					qcom,lra-f0-min = <0x78>;
					qcom,f0-vmax-mv = <0x834>;
					qcom,custom_vmax_mv = <0x206c>;
					status = "disabled";
					compatible = "qcom,hv-haptics";
					reg = <0xf000 0xf100 0xf200>;
					interrupts = <0x07 0xf0 0x01 0x01>;
					interrupt-names = "fifo-empty";
					qcom,vmax-mv = <0x802>;
					qcom,lra-period-us = <0x1a0b>;
					qcom,brake-mode = <0x01>;
					qcom,brake-pattern = [ff 3f 1f];
					qcom,drv-sig-shape = <0x01>;
					qcom,brake-sig-shape = <0x01>;
					qcom,rt-imp-detect;
					nvmem-names = "hap_cfg_sdam";
					nvmem = <&pmk8550_sdam_46>;
					phandle = <0xb6>;

					hap_swr_slave_reg: qcom,hap-swr-slave-reg {
						regulator-name = "hap-swr-slave-reg";
						phandle = <0xb7>;
					};

					effect_0 {
						qcom,effect-id = <0x00>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = <0x7f7f7f7f>;
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_1 {
						qcom,effect-id = <0x01>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f 7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_2 {
						qcom,effect-id = <0x02>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_3 {
						qcom,effect-id = <0x03>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_4 {
						qcom,effect-id = <0x04>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					effect_5 {
						qcom,effect-id = <0x05>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f 7f 7f 7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_0 {
						qcom,primitive-id = <0x00>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = <0x00>;
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_1 {
						qcom,primitive-id = <0x01>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_2 {
						qcom,primitive-id = <0x02>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_3 {
						qcom,primitive-id = <0x03>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_4 {
						qcom,primitive-id = <0x04>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_5 {
						qcom,primitive-id = <0x05>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_6 {
						qcom,primitive-id = <0x06>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_7 {
						qcom,primitive-id = <0x07>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};

					primitive_8 {
						qcom,primitive-id = <0x08>;
						qcom,wf-vmax-mv = <0xe10>;
						qcom,wf-fifo-preload;
						qcom,wf-fifo-data = [7f 7f];
						qcom,wf-fifo-period = <0x00>;
						qcom,wf-auto-res-disable;
						qcom,wf-brake-disable;
					};
				};

				pmih010x_bcl: bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x07 0x47 0x00 0x00 0x07 0x47 0x01 0x00 0x07 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x1a>;
				};

				pmih010x_bcl2: bcl@4900 {
					compatible = "qcom,bcl-v5";
					reg = <0x4900 0x100>;
					interrupts = <0x07 0x49 0x00 0x00 0x07 0x49 0x01 0x00 0x07 0x49 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					status = "disabled";
					phandle = <0xb8>;
				};

				bcl_soc: bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x1b>;
				};
			};
		};
	};

	fragment@12 {
		target = <&thermal_zones>;

		__overlay__ {

			pmih010x_temp_alarm: pmih010x_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pmih010x_tz>;
				phandle = <0xb9>;

				trips {

					pmih010x_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xba>;
					};

					pmih010x_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0xbb>;
					};

					pmih010x_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0xbc>;
					};
				};
			};

			pmih010x_lite_temp_alarm: pmih010x_lite_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pmih010x_lite_tz>;
				phandle = <0xbd>;

				trips {

					pmih010x_lite_trip0: trip0 {
						temperature = <0x1e848>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xbe>;
					};

					pmih010x_lite_trip1: trip1 {
						temperature = <0x20f58>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0xbf>;
					};

					pmih010x_lite_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0xc0>;
					};
				};
			};

			pmih010x-ibat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x00>;

				trips {

					ibat_lvl0: ibat-lvl0 {
						temperature = <0x34bc>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xc1>;
					};
				};
			};

			pmih010x-ibat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x01>;

				trips {

					ibat_lvl1: ibat-lvl1 {
						temperature = <0x3a98>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0xc2>;
					};
				};
			};

			vbat {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x02>;

				trips {

					vbat_lvl0: vbat-lvl0 {
						temperature = <0xaf0>;
						hysteresis = <0x64>;
						type = "passive";
						phandle = <0xc3>;
					};

					vbat_lvl1: vbat-lvl1 {
						temperature = <0xa28>;
						hysteresis = <0x64>;
						type = "passive";
						phandle = <0xc4>;
					};

					vbat_lvl2: vbat-lvl2 {
						temperature = <0x8fc>;
						hysteresis = <0x64>;
						type = "passive";
						phandle = <0xc5>;
					};
				};
			};

			pmih010x-bcl-lvl0 {
				polling-delay-passive = <0x32>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x05>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl0: b-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x29>;
					};
				};
			};

			pmih010x-bcl-lvl1 {
				polling-delay-passive = <0x32>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x06>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl1: b-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x2a>;
					};
				};
			};

			pmih010x-bcl-lvl2 {
				polling-delay-passive = <0x32>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmih010x_bcl>, <0x07>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl2: b-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x2b>;
					};
				};
			};

			socd {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <&bcl_soc>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@13 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmk8550@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmk8550";
				};

				pmk8550_sdam_1: sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0xc6>;

					sm1510_present: sm1510_present@5d {
						reg = <0x5d 0x01>;
						bits = <0x05 0x05>;
						phandle = <0xc7>;
					};

					ocp_log: ocp-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x26>;
					};
				};

				pmk8550_sdam_2: sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0xc8>;

					restart_reason: restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x23>;
					};

					wr_thermal_flag: wr_thermal-flag@58 {
						reg = <0x58 0x01>;
						phandle = <0x28>;
					};

					xo_calib_data: xo_calib-data@59 {
						reg = <0x59 0x01>;
						phandle = <0xc9>;
					};

					alarm_log: alarm-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x27>;
					};

					fmd_set: fmd-set@9a {
						reg = <0x9a 0x01>;
						phandle = <0xca>;
					};

					fmd_cont_after_pon: fmd-cont-after-pon@9c {
						reg = <0x9c 0x01>;
						phandle = <0xcb>;
					};

					fmd_chg_pon: fmd-chg-pon@9f {
						reg = <0x9f 0x01>;
						phandle = <0xcc>;
					};

					fmd_cnt2_stop: fmd-cnt2-stop@a2 {
						reg = <0xa2 0x01>;
						phandle = <0xcd>;
					};
				};

				pmk8550_sdam_5: sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					phandle = <0x24>;
				};

				pmk8550_sdam_6: sdam@7500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7500>;
					phandle = <0x25>;
				};

				pmk8550_sdam_13: sdam@7c00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7c00>;
					phandle = <0x12>;
				};

				pmk8550_sdam_14: sdam@7d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7d00>;
					phandle = <0x13>;
				};

				pmk8550_sdam_21: sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					phandle = <0x04>;
				};

				pmk8550_sdam_22: sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					phandle = <0x05>;
				};

				pmk8550_sdam_41: sdam@9800 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9800>;
					phandle = <0x14>;
				};

				pmk8550_sdam_43: sdam@9a00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9a00>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0xce>;

					ibb_spur_sqm_timer: sqm-timer@b8 {
						reg = <0xb8 0x02>;
						phandle = <0x15>;
					};
				};

				pmk8550_sdam_46: sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					phandle = <0x17>;
				};

				pmk8550_sdam_71: sdam@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					phandle = <0xcf>;

					usb_mode: usb-mode@50 {
						reg = <0x50 0x01>;
						phandle = <0x3c>;
					};
				};

				pon_hlos@1300 {
					compatible = "qcom,pm8998-pon";
					reg = <0x1300 0x800>;
					reg-names = "pon_hlos", "pon_pbs";

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};

					pwrkey-bark {
						compatible = "qcom,pmk8350-pwrkey-bark";
						interrupts = <0x00 0x13 0x00 0x03>;
						linux,code = <0x74>;
					};

					pwrkey-resin-bark {
						compatible = "qcom,pmk8350-pwrkey-resin-bark";
						interrupts = <0x00 0x13 0x02 0x03>;
						linux,code = <0x74>;
					};
				};

				pmk8550_gpios: pinctrl@b800 {
					compatible = "qcom,pmk8550-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <&alt_sleep_clk_default>;
					pinctrl-names = "default";
					phandle = <0xd0>;

					alt_sleep_clk {

						alt_sleep_clk_default: alt_sleep_clk_default {
							pins = "gpio3";
							function = "func1";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x00>;
							phandle = <0x1c>;
						};
					};
				};

				pmk8550_rtc: rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					phandle = <0xd1>;
				};

				pmk8550-pwm {
					compatible = "qcom,pmk8550-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
				};

				pmk8550_vadc: vadc@9000 {
					compatible = "qcom,spmi-adc5-gen3";
					reg = <0x9000 0x9100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupt-names = "adc-sdam0", "adc-sdam1";
					interrupts = <0x00 0x90 0x01 0x01 0x00 0x91 0x01 0x01>;
					#thermal-sensor-cells = <0x01>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-names = "default";
					pinctrl-0 = <&display_therm_default>, <&backlight_therm_default>, <&conn_therm2_default>, <&quiet_therm_default>, <&charger1_therm_default>;
					phandle = <0x03>;

					pmk8550_offset_ref {
						reg = <0x00>;
						label = "pmk8550_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_vref_1p25 {
						reg = <0x01>;
						label = "pmk8550_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_die_temp {
						reg = <0x03>;
						label = "pmk8550_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_offset_ref {
						reg = <0x100>;
						label = "pm8550_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_vref_1p25 {
						reg = <0x101>;
						label = "pm8550_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_die_temp {
						reg = <0x103>;
						label = "pm8550_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_vph_pwr {
						reg = <0x18e>;
						label = "pm8550_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pmk8550_xo_therm {
						reg = <0x44>;
						label = "pmk8550_xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_offset_ref {
						reg = <0x700>;
						label = "pmih010x_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc5-gen4;
					};

					pmih010x_vref_1p25 {
						reg = <0x701>;
						label = "pmih010x_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc5-gen4;
					};

					pmih010x_die_temp {
						reg = <0x703>;
						label = "pmih010x_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc5-gen4;
					};

					pmih010x_vph_pwr {
						reg = <0x78e>;
						label = "pmih010x_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
						qcom,adc5-gen4;
					};

					pmih010x_vbat_sns_qbg {
						reg = <0x78f>;
						label = "pmih010x_vbat_sns_qbg";
						qcom,pre-scaling = <0x01 0x03>;
						qcom,adc5-gen4;
					};

					pmih010x_iin {
						reg = <0x717>;
						label = "pmih010x_iin";
						qcom,adc5-gen4;
					};

					pmih010x_ichg_fb {
						reg = <0x7a1>;
						label = "pmih010x_ichg_fb";
						qcom,adc5-gen4;
					};

					pmih010x_chg_temp {
						reg = <0x710>;
						label = "pmih010x_chg_temp";
						qcom,adc5-gen4;
					};

					pmih010x_lite_die_temp {
						reg = <0x718>;
						label = "pmih010x_lite_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc5-gen4;
					};

					pm8550vs_f_die_temp {
						reg = <0x503>;
						label = "pm8550vs_f_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550vs_j_die_temp {
						reg = <0x903>;
						label = "pm8550vs_j_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_d_die_temp {
						reg = <0x303>;
						label = "pm8550ve_d_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_g_die_temp {
						reg = <0x603>;
						label = "pm8550ve_g_die_temp";
						qom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_i_die_temp {
						reg = <0x803>;
						label = "pm8550ve_i_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_display_therm {
						reg = <0x149>;
						label = "pm8550_display_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_backlight_therm {
						reg = <0x14a>;
						label = "pm8550_backlight_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_conn_therm2 {
						reg = <0x14b>;
						label = "pm8550_conn_therm2";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_cpu_therm {
						reg = <0x144>;
						label = "pm8550_cpu_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_flash_therm {
						reg = <0x145>;
						label = "pm8550_flash_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_wifi_therm {
						reg = <0x146>;
						label = "pm8550_wifi_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_quiet_therm {
						reg = <0x74a>;
						label = "pmih010x_quiet_therm";
						qcom,ratiometric;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
						qcom,adc5-gen4;
					};

					pmih010x_charger1_therm {
						reg = <0x74d>;
						label = "pmih010x_charger1_therm";
						qcom,ratiometric;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
						qcom,adc5-gen4;
					};

					pmih010x_conn_therm {
						reg = <0x747>;
						label = "pmih010x_conn_therm";
						qcom,ratiometric;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
						qcom,adc5-gen4;
					};

					pmih010x_batt_therm {
						reg = <0x744>;
						label = "pmih010x_batt_therm";
						qcom,ratiometric;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
						qcom,adc5-gen4;
					};
				};
			};
		};
	};

	fragment@14 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmr735d@a {
				compatible = "qcom,spmi-pmic";
				reg = <0x0a 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmr735d";
				};

				pmr735d_tz: pmr735d-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x0a 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x22>;
				};

				pmr735d_gpios: pinctrl@8800 {
					compatible = "qcom,pmr735d-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0xd2>;
				};
			};
		};
	};

	fragment@15 {
		target = <&thermal_zones>;

		__overlay__ {

			pmr735d_temp_alarm: pmr735d_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pmr735d_tz>;
				phandle = <0xd3>;

				trips {

					pmr735d_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0xd4>;
					};

					pmr735d_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "hot";
						phandle = <0xd5>;
					};

					pmr735d_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0xd6>;
					};
				};
			};
		};
	};

	fragment@16 {
		target = <&soc>;

		__overlay__ {

			reboot_reason {
				compatible = "qcom,reboot-reason";
				nvmem-cells = <&restart_reason>;
				nvmem-cell-names = "restart_reason";
			};

			pmic-pon-log {
				compatible = "qcom,pmic-pon-log";
				nvmem = <&pmk8550_sdam_5>, <&pmk8550_sdam_6>;
				nvmem-names = "pon_log0", "pon_log1";
				depends-on-supply = <&gh_watchdog>;
			};

			regulator_ocp_notifier: regulator-ocp-notifier {
				compatible = "qcom,regulator-ocp-notifier";
				interrupt-parent = <&spmi_bus>;
				interrupts = <0x00 0x71 0x01 0x01 0x00 0x85 0x01 0x01>;
				nvmem-cells = <&ocp_log>, <&alarm_log>;
				nvmem-cell-names = "ocp_log", "alarm_log";
				periph-1c1-supply = <&L1B>;
				periph-1c4-supply = <&L4B>;
				periph-1c5-supply = <&L5B>;
				periph-1c6-supply = <&L6B>;
				periph-1c7-supply = <&L7B>;
				periph-1c8-supply = <&L8B>;
				periph-1c9-supply = <&L9B>;
				periph-1ca-supply = <&L10B>;
				periph-1cb-supply = <&L11B>;
				periph-1cd-supply = <&L13B>;
				periph-1ce-supply = <&L14B>;
				periph-1cf-supply = <&L15B>;
				periph-1d1-supply = <&L17B>;
				periph-1e4-supply = <&BOB1>;
				periph-1e6-supply = <&BOB2>;
				periph-39b-supply = <&S1D>;
				periph-39e-supply = <&S2D_LEVEL>;
				periph-3a4-supply = <&S4D>;
				periph-3a7-supply = <&S5D_LEVEL>;
				periph-3c1-supply = <&L1D>;
				periph-3c2-supply = <&L2D>;
				periph-3c3-supply = <&L3D>;
				periph-5c1-supply = <&L1F>;
				periph-5c2-supply = <&L2F>;
				periph-5c3-supply = <&L3F>;
				periph-69b-supply = <&S1G>;
				periph-69e-supply = <&S2G_LEVEL>;
				periph-6a1-supply = <&S3G>;
				periph-6a7-supply = <&S5G_LEVEL>;
				periph-6ad-supply = <&S7G_LEVEL>;
				periph-6c1-supply = <&L1G>;
				periph-6c2-supply = <&L2G>;
				periph-6c3-supply = <&L3G>;
				periph-89b-supply = <&S1I_LEVEL>;
				periph-8a1-supply = <&S3I_LEVEL>;
				periph-8a7-supply = <&S5I_LEVEL>;
				periph-8aa-supply = <&S6I_LEVEL>;
				periph-8ad-supply = <&S7I>;
				periph-8b0-supply = <&S8I>;
				periph-8c1-supply = <&L1I>;
				periph-8c2-supply = <&L2I>;
				periph-8c3-supply = <&L3I>;
				periph-99b-supply = <&S1J_LEVEL>;
				periph-99e-supply = <&S2J>;
				periph-9a1-supply = <&S3J>;
				periph-9c1-supply = <&L1J>;
				periph-9c2-supply = <&L2J>;
				periph-9c3-supply = <&L3J_LEVEL>;
				periph-5a7-supply = <&S5F>;
				periph-5b0-supply = <&S8F_LEVEL>;
				phandle = <0xd7>;
			};
		};
	};

	fragment@17 {
		target = <&thermal_zones>;

		__overlay__ {

			xo-therm {
				polling-delay-passive = <0x1388>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmk8550_vadc>, <0x44>;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};

					active-config1 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};

					trip_config0: trip-config0 {
						temperature = <0x130b0>;
						hysteresis = <0x1f40>;
						type = "passive";
						phandle = <0x35>;
					};

					trip_config1: trip-config1 {
						temperature = <0x13880>;
						hysteresis = <0x2710>;
						type = "passive";
						phandle = <0x36>;
					};

					shutdown-trip {
						temperature = <0x15f90>;
						hysteresis = <0x00>;
						type = "hot";
					};

					display_test_config1: display-test-config1 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
						phandle = <0x37>;
					};

					display_test_config2: display-test-config2 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
						phandle = <0x38>;
					};

					display_test_config3: display-test-config3 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
						phandle = <0x39>;
					};
				};
			};
		};
	};

	fragment@18 {
		target = <&soc>;

		__overlay__ {

			gpu_dump_skip_cdev: qcom,gpu-dump-skip-cdev {
				compatible = "qcom,gpu-dump-skip-cdev";
				nvmem-cells = <&wr_thermal_flag>;
				nvmem-cell-names = "wr_thermal_flag";
				#cooling-cells = <0x02>;
				phandle = <0xd8>;
			};
		};
	};

	fragment@19 {
