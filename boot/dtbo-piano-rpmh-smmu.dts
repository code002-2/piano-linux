	fragment@46 {
		target = <&tlmm>;

		__overlay__ {

			charger_cp_int_master: charger_cp_int_master {
				phandle = <0x42>;

				mux {
					pins = "gpio68";
					function = "gpio";
				};

				config {
					pins = "gpio68";
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			fg_batt_ctl_master: fg_batt_ctl_master {
				phandle = <0x41>;

				mux {
					pins = "gpio112";
					function = "gpio";
				};

				config {
					pins = "gpio112";
					drive-strength = <0x02>;
					bias-pull-down;
					output-enable;
				};
			};

			fg_batt_ctl_slave: fg_batt_ctl_slave {
				phandle = <0x43>;

				mux {
					pins = "gpio113";
					function = "gpio";
				};

