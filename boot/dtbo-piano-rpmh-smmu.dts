	fragment@47 {
		target = <&qupv3_se5_i2c>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			bq27z561_master@55 {
				compatible = "ti,bq27z561_master";
				ic_role = <0x00>;
