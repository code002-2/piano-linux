	fragment@200 {
		target-path = "/";

		__overlay__ {

			framebuffer@fc800000 {
				compatible = "simple-framebuffer";
				reg = <0x00 0xfc800000 0x00 0x2b00000>;
				width = <3200>;
				height = <2136>;
				stride = <12800>;
				format = "a8b8g8r8";
				status = "okay";
